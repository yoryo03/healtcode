---
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import ValueProps from '../components/ValueProps.astro';
import Features from '../components/Features.astro';
import Audiences from '../components/Audiences.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import Compliance from '../components/Compliance.astro';
import Testimonials from '../components/Testimonials.astro';
import Demo from '../components/Demo.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <AnnouncementBar />
  <Header />
  <main>
    <Hero />
    <Stats />
    <ValueProps />
    <Features />
    <Audiences />
    <HowItWorks />
    <Pricing />
    <Compliance />
    <Testimonials />
    <Demo />
    <Faq />
    <CtaBand />
  </main>
  <Footer />
</Layout>
