---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} · ${site.tagline}`, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b111c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CO" />
    <script is:inline>
      // Modo claro u oscuro antes de pintar (evita el parpadeo). Usa lo que la persona eligió con el botón
      // del header; si nunca eligió, sigue la preferencia de su sistema operativo.
      (function () {
        var theme = 'light';
        try {
          var saved = localStorage.getItem('hc-theme');
          if (saved === 'dark' || saved === 'light') theme = saved;
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-canvas font-sans text-ink-soft antialiased">
    <slot />

    <script>
      // Aparición suave de los bloques con data-reveal al hacer scroll.
      // Solo se activa con JavaScript y si el usuario no pidió reducir el movimiento.
      const items = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (items.length > 0 && 'IntersectionObserver' in window && !reduce) {
        // Lo que ya está en pantalla al cargar se muestra de una vez (sin parpadeo).
        items.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-visible');
        });
        document.documentElement.classList.add('js');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        items.filter((el) => !el.classList.contains('is-visible')).forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
