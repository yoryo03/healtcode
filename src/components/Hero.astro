---
import { hero } from '../data/site';
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
  <div class="mx-auto max-w-6xl px-4 py-24 text-center md:py-32">
    <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">
      {hero.eyebrow}
    </span>
    <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 md:text-6xl">
      {hero.title}
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">{hero.subtitle}</p>
    <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
      <a href={hero.primaryCta.href} class="rounded-lg bg-brand-600 px-6 py-3 font-semibold text-white shadow-sm hover:bg-brand-700">
        {hero.primaryCta.label}
      </a>
      <a href={hero.secondaryCta.href} class="rounded-lg border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 hover:border-brand-500 hover:text-brand-600">
        {hero.secondaryCta.label}
      </a>
    </div>
  </div>
</section>
