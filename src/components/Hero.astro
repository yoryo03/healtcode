---
import { hero, mockup } from '../data/site';
import Icon from './Icon.astro';

const estadoClass: Record<string, string> = {
  Confirmado: 'bg-brand-100 text-brand-800',
  'En sala': 'bg-navy-800 text-white',
  Pendiente: 'bg-navy-100 text-navy-600',
};
---

<section class="relative overflow-hidden bg-mist">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_80%_20%,rgb(32_129_107_/_0.12),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 md:py-24 lg:grid-cols-2">
    <div>
      <span class="eyebrow">
        <Icon name="shield" class="h-3.5 w-3.5" />
        {hero.eyebrow}
      </span>
      <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-navy-800 md:text-5xl xl:text-[3.4rem] xl:leading-[1.08]">
        {hero.title}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-navy-500">{hero.subtitle}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={hero.primaryCta.href} class="btn btn-primary">
          {hero.primaryCta.label}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a href={hero.secondaryCta.href} class="btn btn-secondary">{hero.secondaryCta.label}</a>
      </div>

      <div class="mt-8 rounded-xl border border-navy-100 bg-white/70 p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-navy-400">{hero.highlightsTitle}</p>
        <ul class="mt-2 grid gap-x-6 gap-y-2 sm:grid-cols-2">
          {hero.highlights.map((h) => (
            <li class="flex items-start gap-2 text-sm font-medium text-navy-700">
              <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-brand-600 text-white">
                <Icon name="check" class="h-3 w-3" strokeWidth={3} />
              </span>
              {h}
            </li>
          ))}
        </ul>
      </div>

      {
        hero.proof.length > 0 && (
          <p class="mt-5 flex flex-wrap gap-x-6 gap-y-1 text-sm text-navy-500">
            {hero.proof.map((p) => (
              <span class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-500" />
                {p}
              </span>
            ))}
          </p>
        )
      }
    </div>

    <!-- Mockup del producto (ilustrativo, hecho con HTML y CSS) -->
    <div class="relative lg:pl-4" aria-hidden="true">
      <div class="overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-soft">
        <div class="flex items-center gap-1.5 border-b border-navy-100 bg-navy-50 px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-navy-200"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-navy-200"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-navy-200"></span>
          <span class="ml-3 truncate text-xs font-medium text-navy-400">{mockup.sede}</span>
        </div>

        <div class="grid gap-4 p-4 sm:grid-cols-5">
          <div class="flex flex-col rounded-xl border border-navy-100 p-3 sm:col-span-3">
            <div class="flex items-center justify-between">
              <p class="text-xs font-semibold text-navy-800">{mockup.fecha}</p>
              <span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-semibold text-brand-700">
                {mockup.turnos.length} turnos
              </span>
            </div>
            <ul class="mt-3 mb-3 space-y-2">
              {mockup.turnos.map((t) => (
                <li class="flex items-center gap-3 rounded-lg bg-mist px-3 py-2">
                  <span class="w-9 text-xs font-semibold text-navy-800">{t.hora}</span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-xs font-medium text-navy-800">{t.paciente}</span>
                    <span class="block truncate text-[10px] text-navy-400">
                      {t.servicio} · {t.profesional}
                    </span>
                  </span>
                  <span class:list={['shrink-0 rounded-full px-2 py-0.5 text-[10px] font-semibold', estadoClass[t.estado]]}>
                    {t.estado}
                  </span>
                </li>
              ))}
            </ul>
            <div class="mt-auto flex items-center justify-between border-t border-navy-100 pt-3 text-[10px] text-navy-400">
              <span>{mockup.resumen}</span>
              <span class="font-semibold text-brand-700">Ver agenda completa →</span>
            </div>
          </div>

          <div class="space-y-4 sm:col-span-2">
            <div class="rounded-xl border border-navy-100 p-3">
              <p class="text-[10px] font-semibold uppercase tracking-wide text-navy-400">Factura electrónica</p>
              <p class="mt-1 text-sm font-bold text-navy-800">{mockup.factura.numero}</p>
              <p class="text-xs text-navy-500">{mockup.factura.detalle}</p>
              <p class="mt-2 text-xl font-extrabold text-navy-800">{mockup.factura.total}</p>
              <p class="mt-2 inline-flex items-center gap-1 rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-semibold text-brand-700">
                <Icon name="check" class="h-3 w-3" strokeWidth={3} />
                {mockup.factura.estado}
              </p>
            </div>

            <div class="rounded-xl border border-navy-100 p-3">
              <p class="text-[10px] font-semibold uppercase tracking-wide text-navy-400">Nómina electrónica</p>
              <p class="mt-1 text-sm font-bold text-navy-800">{mockup.nomina.periodo}</p>
              <p class="text-xs text-navy-500">{mockup.nomina.detalle}</p>
              <div class="mt-3 h-1.5 w-full rounded-full bg-navy-100">
                <div class="h-1.5 w-full rounded-full bg-brand-500"></div>
              </div>
              <p class="mt-2 inline-flex items-center gap-1 rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-semibold text-brand-700">
                <Icon name="check" class="h-3 w-3" strokeWidth={3} />
                {mockup.nomina.estado}
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="absolute -bottom-5 left-2 hidden items-center gap-3 rounded-xl border border-navy-100 bg-white px-3 py-2 shadow-soft md:flex lg:-left-6">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-white">
          <Icon name="message" class="h-4 w-4" />
        </span>
        <span>
          <span class="block text-xs font-semibold text-navy-800">{mockup.whatsapp.titulo}</span>
          <span class="block text-[11px] text-navy-400">{mockup.whatsapp.detalle}</span>
        </span>
      </div>
    </div>
  </div>
</section>
