---
import { hero, mockup, whatsappUrl } from '../data/site';
import Icon from './Icon.astro';

const estadoClass: Record<string, string> = {
  Confirmada: 'bg-brand-100 text-brand-800',
  'En sala': 'bg-navy-800 text-white',
  Pendiente: 'bg-navy-100 text-navy-600',
};

const proofIcons = [
  { icon: 'stethoscope', class: 'bg-brand-600 text-white' },
  { icon: 'building', class: 'bg-navy-800 text-mint-300' },
  { icon: 'hospital', class: 'bg-mint-400 text-navy-950' },
];
---

<section class="clip-diagonal-b relative isolate overflow-hidden bg-navy-950 text-white">
  <!-- Fondo: brillos de marca y cuadrícula -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-40 right-[-10%] h-[38rem] w-[38rem] rounded-full bg-brand-600/45 blur-3xl"></div>
    <div class="absolute -bottom-48 -left-40 h-[30rem] w-[30rem] rounded-full bg-mint-400/15 blur-3xl"></div>
    <div class="pattern-grid fade-mask absolute inset-0"></div>
  </div>

  <div
    class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 px-4 pt-14 pb-44 sm:pt-20 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-10 lg:pb-52"
  >
    <div class="min-w-0">
      <span class="eyebrow eyebrow-dark">
        <Icon name="shield" class="h-3.5 w-3.5" />
        {hero.eyebrow}
      </span>

      <h1 class="mt-6 text-[2.6rem] leading-[0.95] font-black tracking-tight uppercase sm:text-6xl lg:text-[3.25rem]">
        <span class="sr-only">{hero.srTitle}</span>
        <span aria-hidden="true">
          {hero.titleLines.map((line, i) => <span class:list={['block', i === 0 && 'text-navy-300']}>{line}</span>)}
          <span class="block min-h-[1.9em] lg:min-h-[0.95em]">
            <span id="hero-rotator" class="text-gradient-mint" data-words={JSON.stringify(hero.rotating)}>{hero.rotating[0]}</span><span class="animate-blink ml-1.5 inline-block h-[0.78em] w-[0.08em] bg-mint-400 align-[-0.04em] motion-reduce:animate-none"></span>
          </span>
        </span>
      </h1>

      <p class="mt-7 max-w-xl text-lg leading-relaxed text-navy-200">{hero.subtitle}</p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={hero.primaryCta.href} class="btn btn-mint btn-lg">
          {hero.primaryCta.label}
          <Icon name="arrow-right" class="h-4 w-4" strokeWidth={2.5} />
        </a>
        <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-white btn-lg">
          <Icon name="whatsapp" class="h-5 w-5 text-brand-600" />
          {hero.whatsappLabel}
        </a>
        <a href={hero.secondaryCta.href} class="btn btn-outline-white btn-lg">{hero.secondaryCta.label}</a>
      </div>

      <div class="mt-10 flex max-w-md items-center gap-2" aria-hidden="true">
        <span class="h-1 w-2/3 rounded-full bg-linear-to-r from-mint-400 to-brand-500"></span>
        <span class="h-1 flex-1 rounded-full bg-white/15"></span>
      </div>
      <p class="mt-5 max-w-lg text-navy-200 italic">{hero.tagline}</p>

      {
        hero.proof && (
          <div class="mt-6 inline-flex items-center gap-3 rounded-2xl bg-white py-2 pr-5 pl-2 text-sm text-navy-600 shadow-card sm:rounded-full">
            <span class="flex shrink-0 -space-x-2" aria-hidden="true">
              {proofIcons.map((p) => (
                <span class:list={['flex h-8 w-8 items-center justify-center rounded-full ring-2 ring-white', p.class]}>
                  <Icon name={p.icon} class="h-4 w-4" />
                </span>
              ))}
            </span>
            <span>
              <strong class="font-black text-navy-900">{hero.proof.value}</strong> {hero.proof.text}
            </span>
          </div>
        )
      }
    </div>

    <!-- Mockup del producto (ilustrativo, hecho con HTML y CSS) -->
    <div class="relative mx-auto w-full max-w-xl min-w-0 lg:max-w-none" aria-hidden="true">
      <div class="absolute -inset-10 -z-10 rounded-full bg-brand-600/30 blur-3xl"></div>

      <div
        class="overflow-hidden rounded-2xl bg-white text-navy-800 shadow-card ring-1 ring-white/20 lg:[transform:perspective(1800px)_rotateY(-8deg)_rotateX(3deg)]"
      >
        <div class="flex items-center gap-1.5 border-b border-navy-100 bg-navy-50 px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-navy-200"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-navy-200"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-navy-200"></span>
          <span class="ml-3 inline-flex min-w-0 items-center gap-1 truncate rounded-md bg-white px-2 py-0.5 text-[11px] font-medium text-navy-400 ring-1 ring-navy-100">
            <Icon name="lock" class="h-3 w-3 shrink-0" />
            {mockup.url}
          </span>
          <span class="ml-auto hidden text-[11px] font-semibold text-navy-500 sm:block">{mockup.sede}</span>
        </div>

        <div class="grid gap-3 p-4 sm:grid-cols-5">
          <div class="flex flex-col rounded-xl border border-navy-100 p-3 sm:col-span-3">
            <div class="flex items-center justify-between">
              <p class="text-xs font-bold text-navy-800">{mockup.fecha}</p>
              <span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-bold text-brand-700">
                {mockup.turnos.length} {mockup.citasLabel}
              </span>
            </div>
            <ul class="mt-3 mb-3 space-y-2">
              {
                mockup.turnos.map((t) => (
                  <li class="flex items-center gap-3 rounded-lg bg-mist px-3 py-2">
                    <span class="w-9 text-xs font-bold text-navy-800">{t.hora}</span>
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-xs font-semibold text-navy-800">{t.paciente}</span>
                      <span class="block truncate text-[10px] text-navy-400">
                        {t.servicio} · {t.profesional}
                      </span>
                    </span>
                    <span class:list={['shrink-0 rounded-full px-2 py-0.5 text-[10px] font-bold', estadoClass[t.estado] ?? 'bg-navy-100 text-navy-600']}>
                      {t.estado}
                    </span>
                  </li>
                ))
              }
            </ul>
            <div class="mt-auto flex items-center justify-between border-t border-navy-100 pt-3 text-[10px] text-navy-400">
              <span>{mockup.resumen}</span>
              <span class="font-bold text-brand-700">{mockup.verAgenda} →</span>
            </div>
          </div>

          <div class="space-y-3 sm:col-span-2">
            <div class="rounded-xl border border-navy-100 p-3">
              <p class="text-[10px] font-bold tracking-wide text-navy-400 uppercase">{mockup.factura.label}</p>
              <p class="mt-1 text-sm font-black text-navy-900">{mockup.factura.numero}</p>
              <p class="text-[11px] text-navy-500">{mockup.factura.detalle}</p>
              <p class="mt-2 text-xl font-black text-navy-900">{mockup.factura.total}</p>
              <p class="mt-2 inline-flex items-center gap-1 rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-bold text-brand-700">
                <Icon name="check" class="h-3 w-3" strokeWidth={3} />
                {mockup.factura.estado}
              </p>
            </div>

            <div class="rounded-xl bg-navy-900 p-3 text-white">
              <div class="flex items-center justify-between">
                <p class="text-[10px] font-bold tracking-wide text-mint-300 uppercase">{mockup.rda.label}</p>
                <span class="rounded-full bg-mint-400 px-1.5 py-0.5 text-[9px] font-black text-navy-950 uppercase">{mockup.rda.badge}</span>
              </div>
              <p class="mt-1 text-sm leading-tight font-black">{mockup.rda.titulo}</p>
              <p class="mt-0.5 text-[11px] text-navy-300">{mockup.rda.detalle}</p>
              <ol class="mt-3 flex items-center">
                {
                  mockup.rda.pasos.map((_, i) => (
                    <li class:list={['flex items-center', i < mockup.rda.pasos.length - 1 && 'flex-1']}>
                      <span class="flex h-4 w-4 items-center justify-center rounded-full bg-mint-400 text-navy-950">
                        <Icon name="check" class="h-2.5 w-2.5" strokeWidth={3.5} />
                      </span>
                      {i < mockup.rda.pasos.length - 1 && <span class="mx-1 h-0.5 flex-1 rounded-full bg-mint-400/60" />}
                    </li>
                  ))
                }
              </ol>
              <div class="mt-1 flex justify-between text-[9px] text-navy-300">
                {mockup.rda.pasos.map((p) => <span>{p}</span>)}
              </div>
              <p class="mt-2 inline-flex items-center gap-1 rounded-full bg-white/10 px-2 py-0.5 text-[10px] font-bold text-mint-300">
                <Icon name="send" class="h-3 w-3" strokeWidth={2.5} />
                {mockup.rda.estado}
              </p>
            </div>
          </div>
        </div>
      </div>

      <div
        class="animate-float absolute -top-6 right-3 hidden items-center gap-3 rounded-2xl bg-white px-3.5 py-2.5 text-navy-800 shadow-card ring-1 ring-navy-100 motion-reduce:animate-none sm:flex lg:-right-4"
      >
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-navy-900 text-mint-300">
          <Icon name="banknote" class="h-5 w-5" />
        </span>
        <span>
          <span class="block text-xs font-bold">{mockup.chipNomina.titulo}</span>
          <span class="block text-[11px] text-navy-400">{mockup.chipNomina.detalle}</span>
        </span>
      </div>

      <div
        class="animate-float-slow absolute -bottom-7 left-3 hidden items-center gap-3 rounded-2xl bg-white px-3.5 py-2.5 text-navy-800 shadow-card ring-1 ring-navy-100 motion-reduce:animate-none sm:flex lg:-left-8"
      >
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-whatsapp text-navy-950">
          <Icon name="whatsapp" class="h-5 w-5" />
        </span>
        <span>
          <span class="block text-xs font-bold">{mockup.chipWhatsapp.titulo}</span>
          <span class="block text-[11px] text-navy-400">{mockup.chipWhatsapp.detalle}</span>
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  // Efecto de máquina de escribir en el título: borra y escribe cada frase de `hero.rotating`.
  const el = document.getElementById('hero-rotator');
  const words: string[] = el ? JSON.parse(el.dataset.words ?? '[]') : [];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && words.length > 1) {
    let w = 0;
    if (reduce) {
      window.setInterval(() => {
        w = (w + 1) % words.length;
        el.textContent = words[w];
      }, 2800);
    } else {
      let i = words[0].length;
      let deleting = true;
      const tick = () => {
        if (deleting) {
          i -= 1;
          el.textContent = words[w].slice(0, i);
          if (i <= 0) {
            deleting = false;
            w = (w + 1) % words.length;
            window.setTimeout(tick, 300);
            return;
          }
          window.setTimeout(tick, 35);
        } else {
          i += 1;
          el.textContent = words[w].slice(0, i);
          if (i >= words[w].length) {
            deleting = true;
            window.setTimeout(tick, 2200);
            return;
          }
          window.setTimeout(tick, 75);
        }
      };
      window.setTimeout(tick, 2200);
    }
  }
</script>
