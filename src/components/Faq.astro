---
import { faq, site } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="faq" class="scroll-mt-28 bg-mist py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid gap-10 lg:grid-cols-3">
      <div>
        <SectionHeading
          eyebrow="Preguntas frecuentes"
          title="Preguntas frecuentes"
          subtitle="¿Tienes otra pregunta? Te respondemos por WhatsApp o en una demostración en vivo."
          align="left"
        />
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="btn btn-secondary mt-6">
          <Icon name="message" class="h-4 w-4 text-brand-600" />
          Escribir por WhatsApp
        </a>
      </div>
      <div class="space-y-3 lg:col-span-2">
        {faq.map((item) => (
          <details class="group rounded-xl border border-navy-100 bg-white px-5 py-4 open:shadow-soft">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-navy-800 [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-navy-200 text-navy-500 transition group-open:rotate-45 group-open:border-brand-600 group-open:text-brand-600">
                <Icon name="plus" class="h-4 w-4" />
              </span>
            </summary>
            <p class="mt-3 leading-relaxed text-navy-500">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
