---
import { modules } from '../data/site';
import Icon from './Icon.astro';
import Isotipo from './Isotipo.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="modulos" class="scroll-mt-28 bg-canvas-alt py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <SectionHeading eyebrow={modules.eyebrow} title={modules.title} highlight={modules.highlight} subtitle={modules.subtitle} />

    <!-- Dos columnas; el módulo destacado (featured) ocupa toda la fila -->
    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        modules.items.map((m, i) => (
          <div data-reveal style={`--reveal-delay:${(i % 2) * 100}ms`} class:list={[m.featured && 'md:col-span-2']}>
            <article
              class:list={[
                'relative flex h-full flex-col gap-5 overflow-hidden rounded-3xl p-7 transition hover:-translate-y-1 sm:flex-row sm:gap-6 sm:p-8',
                m.featured
                  ? 'bg-linear-to-br from-brand-600 via-brand-700 to-navy-900 text-white shadow-glow md:p-10'
                  : 'border border-line bg-card text-ink hover:shadow-soft',
              ]}
            >
              {m.featured && (
                <Isotipo variant="outline" class="pointer-events-none absolute -right-14 -bottom-14 h-64 w-64 text-white/20" />
              )}
              <span
                class:list={[
                  'relative flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl sm:h-20 sm:w-20',
                  m.featured
                    ? 'bg-white/15 text-white ring-1 ring-white/25'
                    : 'bg-navy-900 text-mint-300 dark:bg-navy-950 dark:ring-1 dark:ring-white/10',
                ]}
              >
                <Icon name={m.icon} class="h-7 w-7 sm:h-9 sm:w-9" strokeWidth={1.6} />
              </span>

              <div class="relative flex min-w-0 flex-1 flex-col">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class:list={['font-black tracking-tight text-balance uppercase', m.featured ? 'text-xl sm:text-2xl' : 'text-lg']}>
                    {m.title}
                  </h3>
                  {m.badge && (
                    <span
                      class:list={[
                        'rounded-full px-2.5 py-0.5 text-[11px] font-black tracking-wider uppercase',
                        m.featured ? 'bg-mint-400 text-navy-950' : 'bg-brand-600 text-white',
                      ]}
                    >
                      {m.badge}
                    </span>
                  )}
                </div>
                <p class:list={['mt-2 text-sm leading-relaxed', m.featured ? 'max-w-2xl text-white' : 'text-ink-muted']}>{m.description}</p>
                <ul class:list={['mt-4 grid gap-2', m.featured && 'gap-x-8 sm:grid-cols-2 md:max-w-3xl']}>
                  {m.bullets.map((b) => (
                    <li class:list={['flex items-start gap-2 text-sm', m.featured ? 'text-white' : 'text-ink-soft']}>
                      <Icon
                        name="check"
                        class={`mt-0.5 h-4 w-4 shrink-0 ${m.featured ? 'text-mint-300' : 'text-accent'}`}
                        strokeWidth={2.5}
                      />
                      {b}
                    </li>
                  ))}
                </ul>
                {m.featured && (
                  <a href={modules.featuredCta.href} class="btn btn-sm btn-white mt-6 self-start">
                    {modules.featuredCta.label}
                    <Icon name="arrow-right" class="h-3.5 w-3.5" strokeWidth={2.5} />
                  </a>
                )}
              </div>
            </article>
          </div>
        ))
      }
    </div>

    <!-- Un solo llamado a la acción para todos los módulos -->
    <div data-reveal class="mt-14 flex flex-col items-center gap-4 text-center">
      <p class="max-w-xl text-pretty text-ink-muted">{modules.ctaNote}</p>
      <a href={modules.cta.href} class="btn btn-dark btn-lg">
        {modules.cta.label}
        <Icon name="arrow-right" class="h-4 w-4" strokeWidth={2.5} />
      </a>
    </div>
  </div>
</section>
