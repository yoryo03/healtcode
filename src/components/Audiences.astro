---
import { audiences, ctaBoxes } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import CtaBox from './CtaBox.astro';
---

<section class="bg-mist py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <SectionHeading eyebrow={audiences.eyebrow} title={audiences.title} highlight={audiences.highlight} subtitle={audiences.subtitle} />

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        audiences.items.map((a, i) => (
          <div data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <div class="group relative flex h-full flex-col overflow-hidden rounded-3xl bg-white p-8 ring-1 ring-navy-100 transition hover:-translate-y-1 hover:shadow-soft">
              <span class="absolute inset-x-0 top-0 h-1.5 bg-linear-to-r from-brand-500 to-mint-400" aria-hidden="true" />
              <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 transition group-hover:bg-brand-600 group-hover:text-white">
                <Icon name={a.icon} class="h-7 w-7" />
              </span>
              <h3 class="mt-6 text-2xl font-black tracking-tight text-navy-900 uppercase">{a.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-500">{a.description}</p>
              <ul class="mt-5 flex-1 space-y-2.5">
                {a.bullets.map((b) => (
                  <li class="flex items-start gap-2 text-sm font-medium text-navy-700">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" strokeWidth={2.5} />
                    {b}
                  </li>
                ))}
              </ul>
              <a href={a.cta.href} class="mt-7 inline-flex items-center gap-1 text-sm font-bold text-brand-700 hover:text-brand-800">
                {a.cta.label}
                <Icon name="chevron-right" class="h-4 w-4" strokeWidth={2.5} />
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <CtaBox {...ctaBoxes.plans} class="mt-14" />
  </div>
</section>
