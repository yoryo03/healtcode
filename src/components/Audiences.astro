---
import { audiences } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section class="py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <SectionHeading
      eyebrow="Para quién"
      title="Para consultorios, clínicas e IPS"
      subtitle="El mismo software crece contigo: de un profesional independiente a una red con varias sedes."
    />
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {audiences.map((a) => (
        <div class="rounded-2xl bg-mist p-7">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-white text-navy-800 shadow-sm">
            <Icon name={a.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-5 text-xl font-semibold text-navy-800">{a.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy-500">{a.description}</p>
          <ul class="mt-5 space-y-2">
            {a.bullets.map((b) => (
              <li class="flex items-start gap-2 text-sm font-medium text-navy-700">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-600" />
                {b}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
