---
import { site, demo, ui, whatsappUrl } from '../data/site';
import Icon from './Icon.astro';
import Highlight from './Highlight.astro';

const inputClass =
  'mt-1.5 w-full rounded-xl border border-navy-200 bg-white px-3.5 py-2.5 text-navy-800 placeholder:text-navy-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 focus:outline-hidden';
const labelClass = 'text-sm font-semibold text-navy-700';
---

<section id="demo" class="relative isolate scroll-mt-28 overflow-hidden bg-navy-950 py-20 text-white md:py-28">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-1/3 -right-40 h-[32rem] w-[32rem] rounded-full bg-brand-600/40 blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-mint-400/15 blur-3xl"></div>
    <div class="pattern-grid fade-mask absolute inset-0"></div>
  </div>

  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 lg:grid-cols-2 lg:items-center">
    <div data-reveal class="min-w-0">
      <span class="eyebrow eyebrow-dark">{demo.eyebrow}</span>
      <h2 class="mt-4 text-3xl leading-[1.02] font-black tracking-tight text-balance uppercase sm:text-4xl md:text-5xl">
        <Highlight text={demo.title} highlight={demo.highlight} class="text-mint-400" />
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-navy-200">{demo.subtitle}</p>
      <ul class="mt-8 space-y-3">
        {
          demo.bullets.map((b) => (
            <li class="flex items-start gap-3 font-medium text-navy-50">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-mint-400 text-navy-950">
                <Icon name="check" class="h-3 w-3" strokeWidth={3} />
              </span>
              {b}
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-col gap-3 text-sm sm:flex-row sm:flex-wrap sm:gap-6">
        <a href={whatsappUrl()} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-semibold text-navy-100 hover:text-white">
          <Icon name="whatsapp" class="h-5 w-5 text-mint-400" />
          {ui.whatsappShort}
        </a>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="inline-flex items-center gap-2 font-semibold text-navy-100 hover:text-white">
          <Icon name="phone" class="h-4 w-4 text-mint-400" />
          {site.phone}
        </a>
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 font-semibold text-navy-100 hover:text-white">
          <Icon name="mail" class="h-4 w-4 text-mint-400" />
          {site.email}
        </a>
      </div>
    </div>

    <!-- Sin backend por ahora: al enviar abre el cliente de correo. Se puede conectar a Formspree, Netlify Forms, etc. -->
    <div data-reveal style="--reveal-delay:120ms" class="relative min-w-0">
      <div class="absolute -inset-1 -z-10 rounded-[1.75rem] bg-linear-to-br from-mint-400/50 to-brand-600/50 blur-xl" aria-hidden="true"></div>
      <form id="demo-form" class="rounded-3xl bg-white p-6 text-navy-800 shadow-card sm:p-9">
        <h3 class="text-2xl font-black tracking-tight text-navy-900 uppercase">{demo.formTitle}</h3>
        <p class="mt-1 text-sm text-navy-500">{demo.formSubtitle}</p>

        <div class="mt-7 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class={labelClass}>{demo.fields.name}</label>
            <input id="name" name="name" required autocomplete="name" class={inputClass} />
          </div>
          <div>
            <label for="institution" class={labelClass}>{demo.fields.institution}</label>
            <input id="institution" name="institution" required autocomplete="organization" class={inputClass} />
          </div>
          <div>
            <label for="email" class={labelClass}>{demo.fields.email}</label>
            <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} />
          </div>
          <div>
            <label for="phone" class={labelClass}>{demo.fields.phone}</label>
            <input id="phone" name="phone" type="tel" required autocomplete="tel" class={inputClass} />
          </div>
          <div class="sm:col-span-2">
            <label for="type" class={labelClass}>{demo.fields.type}</label>
            <select id="type" name="type" class={inputClass}>
              {demo.institutionTypes.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="message" class={labelClass}>{demo.fields.message}</label>
            <textarea id="message" name="message" rows="3" class={inputClass}></textarea>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg mt-7 w-full">
          {demo.submitLabel}
          <Icon name="arrow-right" class="h-4 w-4" strokeWidth={2.5} />
        </button>
        <p class="mt-3 text-center text-xs text-navy-400">{demo.privacyNote}</p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ email: site.email, subjectPrefix: demo.mailSubject, labels: demo.fields }}>
  document.getElementById('demo-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.target);
    const subject = encodeURIComponent(`${subjectPrefix} · ${f.get('institution')}`);
    const body = encodeURIComponent(
      [
        `${labels.name}: ${f.get('name')}`,
        `${labels.institution}: ${f.get('institution')} (${f.get('type')})`,
        `${labels.email}: ${f.get('email')}`,
        `${labels.phone}: ${f.get('phone')}`,
        '',
        `${f.get('message') || ''}`,
      ].join('\n')
    );
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
