---
import { features } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="funcionalidades" class="scroll-mt-28 bg-mist py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <SectionHeading
      eyebrow="Funcionalidades"
      title="Funciones del software médico"
      subtitle="Del turno a la historia clínica, la factura, el RIPS y la nómina, en una sola plataforma."
    />
    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <article class="flex flex-col rounded-2xl border border-navy-100 bg-white p-7 transition hover:-translate-y-0.5 hover:shadow-soft">
          <div class="flex items-start justify-between">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-navy-800 text-brand-300">
              <Icon name={f.icon} class="h-6 w-6" />
            </span>
            {f.badge && (
              <span class="rounded-full bg-brand-600 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-white">
                {f.badge}
              </span>
            )}
          </div>
          <h3 class="mt-5 text-xl font-semibold text-navy-800">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy-500">{f.description}</p>
          <ul class="mt-5 space-y-2 border-t border-navy-100 pt-5">
            {f.bullets.map((b) => (
              <li class="flex items-start gap-2 text-sm text-navy-600">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" strokeWidth={2.5} />
                {b}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
