---
import { ecosystem } from '../data/site';
import Icon from './Icon.astro';
import Isotipo from './Isotipo.astro';
import Highlight from './Highlight.astro';

// Posición de cada nodo alrededor del logo (desde pantallas sm). Coinciden con las líneas del SVG (lienzo 400×320).
const positions = [
  'sm:left-[12%] sm:top-[14%]',
  'sm:left-[12%] sm:top-1/2',
  'sm:left-[12%] sm:top-[84%]',
  'sm:left-[88%] sm:top-[14%]',
  'sm:left-[88%] sm:top-1/2',
  'sm:left-[88%] sm:top-[84%]',
];
const paths = [
  'M200 160 H120 V45 H48',
  'M200 160 H48',
  'M200 160 H120 V269 H48',
  'M200 160 H280 V45 H352',
  'M200 160 H352',
  'M200 160 H280 V269 H352',
];
const nodes = ecosystem.nodes.slice(0, positions.length);
---

<section class="overflow-hidden py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 px-4 lg:grid-cols-2">
    <div data-reveal class="min-w-0">
      <span class="eyebrow">{ecosystem.eyebrow}</span>
      <h2 class="mt-4 text-3xl leading-[1.02] font-black tracking-tight text-balance text-navy-900 uppercase sm:text-4xl md:text-5xl">
        <Highlight text={ecosystem.title} highlight={ecosystem.highlight} />
      </h2>
      <p class="mt-5 text-lg text-navy-500">{ecosystem.subtitle}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={ecosystem.primaryCta.href} class="btn btn-dark btn-lg">
          {ecosystem.primaryCta.label}
          <Icon name="arrow-right" class="h-4 w-4" strokeWidth={2.5} />
        </a>
        <a
          href={ecosystem.secondaryCta.href}
          class="group inline-flex items-center justify-center gap-1 px-2 py-2 text-sm font-bold text-navy-800 hover:text-brand-700"
        >
          {ecosystem.secondaryCta.label}
          <Icon name="chevron-right" class="h-4 w-4 transition group-hover:translate-x-0.5" strokeWidth={2.5} />
        </a>
      </div>
    </div>

    <div data-reveal style="--reveal-delay:120ms" class="mx-auto w-full max-w-xl min-w-0">
      <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:relative sm:block sm:aspect-[5/4]">
        <svg class="pointer-events-none absolute inset-0 hidden h-full w-full sm:block" viewBox="0 0 400 320" fill="none" aria-hidden="true">
          <g class="stroke-brand-200" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            {paths.slice(0, nodes.length).map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
          </g>
          <g class="flow-dash stroke-brand-600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            {paths.slice(0, nodes.length).map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
          </g>
        </svg>

        <div class="col-span-2 flex justify-center sm:absolute sm:top-1/2 sm:left-1/2 sm:-translate-x-1/2 sm:-translate-y-1/2">
          <div class="relative flex h-24 w-24 items-center justify-center rounded-3xl bg-navy-900 shadow-card sm:h-28 sm:w-28">
            <span class="animate-pulse-ring absolute inset-0 rounded-3xl bg-brand-500/40 motion-reduce:hidden" aria-hidden="true"></span>
            <Isotipo variant="white" class="relative h-12 w-12 sm:h-14 sm:w-14" />
          </div>
        </div>

        {
          nodes.map((n, i) => (
            <div class:list={['flex flex-col items-center text-center sm:absolute sm:w-32 sm:-translate-x-1/2 sm:-translate-y-[28px]', positions[i]]}>
              <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-brand-700 shadow-soft ring-1 ring-navy-100">
                <Icon name={n.icon} class="h-7 w-7" />
              </span>
              <p class="mt-2 text-sm leading-tight font-black text-navy-900 uppercase">{n.title}</p>
              <p class="mt-0.5 text-xs leading-snug text-navy-500">{n.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
