---
import { site, nav, hero } from '../data/site';
import Icon from './Icon.astro';
---

<header class="sticky top-0 z-50 border-b border-navy-100 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href="/" class="flex items-center" aria-label={`${site.name}, inicio`}>
      <img src="/logo.svg" alt={site.name} class="h-7 w-auto" width="159" height="40" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Principal">
      {nav.map((item) => (
        <a href={item.href} class="text-sm font-medium text-navy-600 transition hover:text-brand-700">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={site.loginUrl} class="text-sm font-semibold text-navy-700 hover:text-brand-700">Ingresar</a>
      <a href={hero.primaryCta.href} class="btn btn-primary px-4 py-2">{hero.primaryCta.label}</a>
    </div>

    <button
      id="menu-btn"
      class="rounded-lg p-2 text-navy-700 hover:bg-navy-50 lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="h-6 w-6" />
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-navy-100 bg-white px-4 py-4 lg:hidden" aria-label="Principal móvil">
    {nav.map((item) => (
      <a href={item.href} class="block rounded-lg px-2 py-2.5 font-medium text-navy-700 hover:bg-navy-50">
        {item.label}
      </a>
    ))}
    <div class="mt-3 flex flex-col gap-2 border-t border-navy-100 pt-4">
      <a href={hero.primaryCta.href} class="btn btn-primary">{hero.primaryCta.label}</a>
      <a href={site.loginUrl} class="btn btn-secondary">Ingresar</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };
  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
