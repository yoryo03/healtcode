---
import { site, nav, hero, ui } from '../data/site';
import Icon from './Icon.astro';
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-navy-950/90 text-white backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4">
    <a href="/" class="flex shrink-0 items-center" aria-label={`${site.name}, inicio`}>
      <img src="/logo-white.svg" alt={site.name} class="h-7 w-auto" width="159" height="40" />
    </a>

    <nav class="hidden items-center gap-5 xl:gap-6 lg:flex" aria-label={ui.mainNav}>
      {
        nav.map((item) => (
          <a href={item.href} class="inline-flex items-center gap-1.5 text-sm font-semibold text-navy-200 transition hover:text-white">
            {item.label}
            {item.badge && (
              <span class="rounded-full bg-mint-400 px-1.5 py-0.5 text-[9px] leading-none font-black tracking-wider text-navy-950 uppercase">
                {item.badge}
              </span>
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <!-- Botón de modo oscuro: luna en modo claro, sol en modo oscuro -->
      <button
        id="theme-btn"
        type="button"
        class="theme-toggle flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-navy-200 ring-1 ring-white/15 transition hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint-400"
        aria-label={ui.darkMode}
        aria-pressed="false"
        title={ui.darkMode}
      >
        <Icon name="moon" class="h-5 w-5 dark:hidden" />
        <Icon name="sun" class="hidden h-5 w-5 dark:block" />
      </button>

      <div class="hidden items-center gap-2 lg:flex">
        <a href={site.loginUrl} class="btn btn-sm btn-outline-white">{ui.login}</a>
        <a href={hero.primaryCta.href} class="btn btn-sm btn-mint">{hero.primaryCta.label}</a>
      </div>

      <button
        id="menu-btn"
        type="button"
        class="rounded-lg p-2 text-white hover:bg-white/10 lg:hidden"
        aria-label={ui.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-open-label={ui.openMenu}
        data-close-label={ui.closeMenu}
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden max-h-[calc(100dvh_-_4rem)] overflow-y-auto border-t border-white/10 bg-navy-950 px-4 py-4 lg:hidden"
    aria-label={ui.mainNav}
  >
    {
      nav.map((item) => (
        <a href={item.href} class="flex items-center gap-2 rounded-lg px-2 py-2.5 font-semibold text-navy-100 hover:bg-white/5">
          {item.label}
          {item.badge && (
            <span class="rounded-full bg-mint-400 px-1.5 py-0.5 text-[9px] leading-none font-black tracking-wider text-navy-950 uppercase">
              {item.badge}
            </span>
          )}
        </a>
      ))
    }
    <div class="mt-3 flex flex-col gap-2 border-t border-white/10 pt-4">
      <a href={hero.primaryCta.href} class="btn btn-mint">{hero.primaryCta.label}</a>
      <a href={site.loginUrl} class="btn btn-outline-white">{ui.login}</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    const label = open ? btn?.dataset.closeLabel : btn?.dataset.openLabel;
    if (label) btn?.setAttribute('aria-label', label);
  };
  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Modo oscuro. Layout.astro ya puso data-theme en <html> antes de pintar; aquí solo se cambia y se recuerda.
  const root = document.documentElement;
  const themeBtn = document.getElementById('theme-btn');
  const STORAGE_KEY = 'hc-theme';
  const syncThemeBtn = () => themeBtn?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  const applyTheme = (theme: 'light' | 'dark', remember: boolean) => {
    root.dataset.theme = theme;
    if (remember) {
      try {
        localStorage.setItem(STORAGE_KEY, theme);
      } catch {
        // Navegación privada o almacenamiento bloqueado: el cambio vale solo para esta visita.
      }
    }
    syncThemeBtn();
  };
  syncThemeBtn();

  themeBtn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Transición suave entre colores donde el navegador la soporta.
    if ('startViewTransition' in document && !reduce) {
      document.startViewTransition(() => applyTheme(next, true));
    } else {
      applyTheme(next, true);
    }
  });

  // Si la persona nunca usó el botón, la página sigue los cambios del sistema operativo.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem(STORAGE_KEY);
    } catch {
      saved = null;
    }
    if (!saved) applyTheme(e.matches ? 'dark' : 'light', false);
  });
</script>

<noscript>
  <style is:inline>
    .theme-toggle { display: none !important; }
  </style>
</noscript>
