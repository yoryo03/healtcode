---
import { finalCta, whatsappUrl } from '../data/site';
import Icon from './Icon.astro';
import Isotipo from './Isotipo.astro';
import Highlight from './Highlight.astro';
---

<section class="clip-diagonal-t relative isolate overflow-hidden bg-linear-to-br from-brand-700 via-brand-800 to-navy-950 pt-32 pb-20 text-white md:pt-40 md:pb-24">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="pattern-grid fade-mask absolute inset-0"></div>
    <Isotipo variant="ghost" class="absolute top-1/2 -right-24 h-[30rem] w-[30rem] -translate-y-1/2 text-white/[0.06]" />
  </div>

  <div class="mx-auto flex max-w-6xl flex-col items-start gap-10 px-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl" data-reveal>
      <h2 class="text-4xl leading-[0.98] font-black tracking-tight text-balance uppercase sm:text-5xl md:text-6xl">
        <Highlight text={finalCta.title} highlight={finalCta.highlight} class="text-mint-300" />
      </h2>
      <p class="mt-5 text-lg text-brand-50">{finalCta.subtitle}</p>
    </div>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row lg:shrink-0" data-reveal style="--reveal-delay:120ms">
      <a href={finalCta.primary.href} class="btn btn-white btn-lg">
        {finalCta.primary.label}
        <Icon name="arrow-right" class="h-4 w-4" strokeWidth={2.5} />
      </a>
      <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg">
        <Icon name="whatsapp" class="h-5 w-5" />
        {finalCta.whatsappLabel}
      </a>
    </div>
  </div>
</section>
