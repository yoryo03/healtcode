---
import { site, finalCta } from '../data/site';
import Icon from './Icon.astro';
---

<section class="relative overflow-hidden bg-navy-800 py-20 text-white">
  <div class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-brand-600/30 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-brand-600/20 blur-3xl" aria-hidden="true"></div>
  <div class="relative mx-auto flex max-w-6xl flex-col items-start justify-between gap-8 px-4 md:flex-row md:items-center">
    <div>
      <h2 class="text-4xl font-extrabold tracking-tight md:text-5xl">{finalCta.title}</h2>
      <p class="mt-3 text-lg text-navy-200">{finalCta.subtitle}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={finalCta.primary.href} class="btn btn-white">
        {finalCta.primary.label}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="btn btn-outline-white">
        <Icon name="message" class="h-4 w-4" />
        {finalCta.secondary.label}
      </a>
    </div>
  </div>
</section>
