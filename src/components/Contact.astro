---
import { site } from '../data/site';
---

<section id="contacto" class="scroll-mt-16 bg-brand-600 py-24 text-white">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 md:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold md:text-4xl">¿Listo para empezar?</h2>
      <p class="mt-4 text-brand-100">Cuéntanos sobre tu proyecto y te respondemos en menos de 24 horas.</p>
      <ul class="mt-8 space-y-3 text-brand-50">
        <li>✉️ <a href={`mailto:${site.email}`} class="underline-offset-4 hover:underline">{site.email}</a></li>
        <li>📞 <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="underline-offset-4 hover:underline">{site.phone}</a></li>
        <li>💬 <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="underline-offset-4 hover:underline">Escríbenos por WhatsApp</a></li>
      </ul>
    </div>

    <!-- Formulario sin backend: abre el cliente de correo. Se puede conectar luego a Formspree, Netlify Forms, etc. -->
    <form id="contact-form" class="space-y-4 rounded-2xl bg-white p-8 text-slate-800 shadow-xl">
      <div>
        <label for="name" class="text-sm font-medium">Nombre</label>
        <input id="name" name="name" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label for="email" class="text-sm font-medium">Correo</label>
        <input id="email" name="email" type="email" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
      </div>
      <div>
        <label for="message" class="text-sm font-medium">Mensaje</label>
        <textarea id="message" name="message" rows="4" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"></textarea>
      </div>
      <button type="submit" class="w-full rounded-lg bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">
        Enviar mensaje
      </button>
    </form>
  </div>
</section>

<script define:vars={{ email: site.email }}>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.target);
    const subject = encodeURIComponent(`Contacto de ${f.get('name')}`);
    const body = encodeURIComponent(`${f.get('message')}\n\n— ${f.get('name')} (${f.get('email')})`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
