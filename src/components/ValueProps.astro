---
import { valueProps } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section class="py-20 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <SectionHeading
      eyebrow="HealthCode en un minuto"
      title="Todo tu consultorio en un solo lugar"
      subtitle="Turnos, historia clínica, factura, RIPS y nómina conectados entre sí, hechos para la norma colombiana."
    />
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {valueProps.map((v) => (
        <div class="rounded-2xl border border-navy-100 p-6">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
            <Icon name={v.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-5 text-lg font-semibold text-navy-800">{v.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy-500">{v.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
