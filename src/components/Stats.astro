---
import { stats, statsLabel } from '../data/site';
---

{
  stats.length > 0 && (
    <section class="relative z-10 -mt-28 px-4 sm:-mt-32" aria-label={statsLabel}>
      <dl class="mx-auto grid max-w-5xl grid-cols-2 gap-px overflow-hidden rounded-3xl bg-navy-100 shadow-card ring-1 ring-navy-100 md:grid-cols-4">
        {stats.map((s) => (
          <div class="flex flex-col-reverse items-center bg-white px-4 py-7 text-center">
            <dt class="mt-1 text-sm font-medium text-navy-500">{s.label}</dt>
            <dd class="bg-linear-to-br from-navy-900 to-brand-600 bg-clip-text text-4xl font-black tracking-tight text-transparent md:text-5xl">
              {s.value}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
