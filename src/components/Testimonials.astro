---
import { testimonials } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

// Iniciales para el avatar (ignora títulos como "Dr.", "Dra.", "Ft.").
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter((w) => !/^(dr|dra|ft|lic|enf)\.?$/i.test(w))
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();
---

{
  testimonials.items.length > 0 && (
    <section class="bg-mist py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-4">
        <SectionHeading eyebrow={testimonials.eyebrow} title={testimonials.title} highlight={testimonials.highlight} />
        <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
          {testimonials.items.map((t, i) => {
            const dark = i === 1;
            return (
              <div data-reveal style={`--reveal-delay:${i * 100}ms`}>
                <figure
                  class:list={[
                    'relative flex h-full flex-col rounded-3xl p-8',
                    dark ? 'bg-navy-900 text-white shadow-card' : 'bg-white ring-1 ring-navy-100',
                  ]}
                >
                  <span
                    class:list={['absolute top-2 right-6 font-serif text-8xl leading-none', dark ? 'text-white/10' : 'text-brand-100']}
                    aria-hidden="true"
                  >
                    “
                  </span>
                  <div class:list={['relative flex gap-0.5', dark ? 'text-mint-400' : 'text-brand-500']} role="img" aria-label={testimonials.ratingLabel}>
                    {Array.from({ length: 5 }).map(() => (
                      <Icon name="star" class="h-4 w-4 fill-current" />
                    ))}
                  </div>
                  <blockquote class:list={['relative mt-5 flex-1 text-[15px] leading-relaxed', dark ? 'text-navy-100' : 'text-navy-700']}>
                    “{t.quote}”
                  </blockquote>
                  <figcaption class:list={['mt-7 flex items-center gap-3 border-t pt-5', dark ? 'border-white/10' : 'border-navy-100']}>
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-brand-500 to-brand-700 text-sm font-black text-white">
                      {initials(t.name)}
                    </span>
                    <span>
                      <span class:list={['block font-bold', dark ? 'text-white' : 'text-navy-900']}>{t.name}</span>
                      <span class:list={['block text-sm', dark ? 'text-navy-300' : 'text-navy-500']}>{t.role}</span>
                    </span>
                  </figcaption>
                </figure>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}
