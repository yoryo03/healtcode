---
import { testimonials } from '../data/site';
---

<section id="testimonios" class="scroll-mt-16 py-24">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-center text-3xl font-bold text-slate-900 md:text-4xl">Lo que dicen nuestros clientes</h2>
    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {testimonials.map((t) => (
        <figure class="rounded-2xl border border-slate-200 p-8">
          <blockquote class="text-lg text-slate-700">“{t.quote}”</blockquote>
          <figcaption class="mt-6">
            <div class="font-semibold text-slate-900">{t.name}</div>
            <div class="text-sm text-slate-500">{t.role}</div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
