---
import { testimonials } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

{
  testimonials.length > 0 && (
    <section class="bg-mist py-20 md:py-24">
      <div class="mx-auto max-w-6xl px-4">
        <SectionHeading eyebrow="Testimonios" title="Lo que dicen quienes ya usan HealthCode" />
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {testimonials.map((t) => (
            <figure class="flex flex-col rounded-2xl border border-navy-100 bg-white p-7">
              <div class="flex gap-0.5 text-brand-500" aria-label="5 de 5 estrellas">
                {Array.from({ length: 5 }).map(() => (
                  <Icon name="star" class="h-4 w-4 fill-current" />
                ))}
              </div>
              <blockquote class="mt-4 flex-1 text-navy-700">“{t.quote}”</blockquote>
              <figcaption class="mt-6 border-t border-navy-100 pt-4">
                <div class="font-semibold text-navy-800">{t.name}</div>
                <div class="text-sm text-navy-500">{t.role}</div>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
