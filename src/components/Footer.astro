---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 text-sm text-slate-500 md:flex-row">
    <p>© {year} {site.name}. Todos los derechos reservados.</p>
    <nav class="flex gap-6">
      {nav.map((item) => <a href={item.href} class="hover:text-brand-600">{item.label}</a>)}
    </nav>
  </div>
</footer>
