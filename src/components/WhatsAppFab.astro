---
/** Botón flotante de WhatsApp (abajo a la derecha). */
import { whatsappFab, whatsappUrl } from '../data/site';
import Icon from './Icon.astro';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  aria-label={whatsappFab.ariaLabel}
  class="group fixed right-4 bottom-4 z-40 flex items-center gap-3 sm:right-6 sm:bottom-6"
>
  <span class="hidden rounded-2xl bg-white px-4 py-2.5 text-right shadow-card ring-1 ring-navy-100 transition group-hover:-translate-x-1 md:block" aria-hidden="true">
    <span class="block text-sm font-bold text-navy-900">{whatsappFab.title}</span>
    <span class="block text-xs font-semibold text-brand-700">{whatsappFab.detail}</span>
  </span>
  <span class="relative flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp-dark text-white shadow-card transition group-hover:scale-105">
    <span class="animate-pulse-ring absolute inset-0 rounded-full bg-whatsapp motion-reduce:hidden" aria-hidden="true"></span>
    <Icon name="whatsapp" class="relative h-7 w-7" strokeWidth={2} />
  </span>
</a>
