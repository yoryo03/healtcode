---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  dark?: boolean;
}
const { eyebrow, title, subtitle, align = 'center', dark = false } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <span class:list={['eyebrow', dark && 'bg-white/10 text-brand-200']}>{eyebrow}</span>}
  <h2 class:list={['mt-4 text-3xl font-bold tracking-tight md:text-4xl', dark ? 'text-white' : 'text-navy-800']}>
    {title}
  </h2>
  {subtitle && <p class:list={['mt-4 text-lg', dark ? 'text-navy-200' : 'text-navy-500']}>{subtitle}</p>}
</div>
