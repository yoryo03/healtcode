---
import { services } from '../data/site';
---

<section id="servicios" class="scroll-mt-16 py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">Nuestros servicios</h2>
      <p class="mt-4 text-slate-600">Todo lo que necesitas para destacar en línea, en un solo lugar.</p>
    </div>
    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {services.map((s) => (
        <article class="rounded-2xl border border-slate-200 p-8 transition hover:-translate-y-1 hover:shadow-lg">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-2xl">{s.icon}</div>
          <h3 class="mt-6 text-xl font-semibold text-slate-900">{s.title}</h3>
          <p class="mt-3 text-slate-600">{s.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
